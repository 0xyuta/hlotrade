# Chain: 999 mainnet, 998 testnet, 31337 anvil
CHAIN_ID=998
RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
# DEPLOYMENTS=../contracts/deployments/998.json   (default)
# STATE_DIR=./state/998                           (default)
BUILDER=0x...
# FILLS_URL (daily builder-file check, chain 999) defaults to https://stats-data.hyperliquid.xyz/{Mainnet|Testnet}/builder_fills/{builder}/{yyyymmdd}.csv.lz4
FILE_DELAY_HOURS=2
POLL_SECONDS=60
LOG_CHUNK=1000
PUBLISH=local:./state/998/public
# PUBLISH=r2     (Cloudflare R2; needs the four R2_* vars below, which are also the wallet registry source when REGISTRY_DIR is unset)
# PUBLISH_PREFIX=   (optional; default "<chainId>/")
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# REWARDS_URL (keeper and verifier read the published files here), testnet example:
# REWARDS_URL=https://files-testnet.hlotrade.xyz/998/
# Keys — set only the one(s) the process needs. Never commit them.
POSTER_KEY=
# PAUSER_KEY on the verifier (every chain, mainnet too): can only pause Checkpoints when a checkpoint is wrong. It is the key of Checkpoints.pauser(), distinct from the poster's and the guardian's. The verifier refuses to start if GUARDIAN_KEY is set: the guardian (a Safe on mainnet) is never held by a process
PAUSER_KEY=
# NEW_POSTER (only for `npm run recovery -w ops`, the read-only recovery report): the replacement poster's address, e.g. 0x... Optional
# NEW_POSTER=
BUILDER_KEY=
# KEEPER_KEY: any key with a little HYPE on HyperEVM, no role. Calls Buyback.openPool() once and Buyback.buy() every 10 min, and settles the newest checkpoint if nobody has
KEEPER_KEY=
# Forwarder (USDC): keep RESERVE_USD in the perps account (builder minimum is 100)
RESERVE_USD=110
MIN_MOVE_USD=10
MIN_CLAIM_USD=1
MIN_HYPE=0.05
# Alerts (optional)
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
